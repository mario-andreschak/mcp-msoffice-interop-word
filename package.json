{
  "name": "mcp-office-interop",
  "version": "1.0.0",
  "description": "MCP Server for Microsoft Office Interop Word",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:protocol": "node scripts/verify-protocol.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/verify-package.mjs",
    "test:word-live": "node scripts/verify-word-live.mjs",
    "postinstall": "node scripts/check-native-addon.mjs"
  },
  "keywords": [
    "mcp",
    "office",
    "word",
    "interop"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "express": "5.2.1",
    "zod": "4.4.3",
    "@modelcontextprotocol/server-legacy": "2.0.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0",
    "npm": ">=11"
  },
  "bin": {
    "mcp-office-interop": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts/check-native-addon.mjs",
    "vendor/winax/src",
    "vendor/winax/LICENSE",
    "vendor/winax/index.js",
    "vendor/winax/activex.js",
    "vendor/winax/binding.gyp",
    "vendor/winax/package.json",
    "vendor/winax/PROVENANCE.md"
  ],
  "optionalDependencies": {
    "node-gyp": "13.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mario-andreschak/mcp-msoffice-interop-word.git"
  },
  "packageManager": "npm@11.19.1"
}
